# Hostarise AI Agent — environment template.
# Copy to .env and fill in. NEVER commit .env. Never paste real values in chat.
# Telegram Bot Token and Gemini API Key are needed ONLY for live mode.
# In mock mode (MOCK_MODE=true) the bot runs with fake providers for testing.

# --- Live credentials (leave empty for mock mode) ---
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=

# --- Access control ---
# Telegram user ID of the owner (numbers only). Only this user can run privileged commands.
OWNER_TELEGRAM_ID=
# Optional comma-separated Telegram user IDs of team members (limited commands).
TEAM_TELEGRAM_IDS=

# --- Modes ---
# Set to "true" to run with mock Telegram/Gemini/browser providers (no real keys needed).
MOCK_MODE=true
# Set to "false" to disable the browser engine entirely (Telegram + Gemini + diagnostics only).
BROWSER_ENABLED=true

# --- Gemini ---
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=60000

# --- Paths / logging ---
DATA_DIR=./data
LOG_LEVEL=info
